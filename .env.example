# Copy to .env (never commit .env) and fill in.
# Source checkout: put .env in the repo root.
# Packaged app: put it in the app's data folder: ~/.compute/.env (Mac) or %LOCALAPPDATA%\compute\.env (Windows).
# Real environment variables always override these.

# The one admin account. Only this email can start the main server and open /admin. Required on the server machine.
COMPUTE_ADMIN_EMAIL=

# Admin password, so `compute server serve` doesn't need --admin-password. Optional; the app's form also asks.
COMPUTE_ADMIN_PASSWORD=

# Shared pool secret for internet-facing pools: nodes and API clients must send it (header x-inference-token).
# Leave empty on a trusted LAN. Set the same value on the server and on every node.
COMPUTE_INF_TOKEN=

# New-account starter balance in weighted FLOPs (default 4e15, about 20 short replies on Qwen3.8-27B).
# COMPUTE_STARTER_FLOPS=4e15
